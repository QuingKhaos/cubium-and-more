{
  "name": "cubium-and-more",
  "title": "Cubium and More",
  "description": "Adds Cubium compatibility to several other mods and tweaks it a bit. Configurable!",
  "author": "QuingKhaos",
  "homepage": "https://discord.gg/SYmkaDjFCt",
  "version": "1.0.0",
  "factorio_version": "2.0",
  "dependencies": [
    "base >= 2.0.77",
    "space-age >= 2.0.77",

    "khaoslib >= 1.17.2",

    "cubium >= 1.0.28",
    "? science-tab >= 1.10.0"
  ],
  "space_travel_required": true,
  "package": {
    "ignore": [
      "mod_info.yml",
      "**/*.md",
      "**/*.svg",
      "**/*.xcf"
    ]
  }
}
